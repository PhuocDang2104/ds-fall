{
  "feature_set": "tilt12",
  "feature_order": [
    "ax",
    "ay",
    "az",
    "gx",
    "gy",
    "gz",
    "acc_mag",
    "gyro_mag",
    "jerk",
    "roll",
    "pitch",
    "tilt_delta"
  ],
  "sampling_rate": 25.0,
  "dt": 0.04,
  "formulas": {
    "acc_mag": "sqrt(ax**2 + ay**2 + az**2)",
    "gyro_mag": "sqrt(gx**2 + gy**2 + gz**2)",
    "jerk": "gradient(acc_mag, dt)",
    "roll": "atan2(ay, az)",
    "pitch": "atan2(-ax, sqrt(ay**2 + az**2))",
    "tilt_delta": "gradient(arccos(clip(az / max(acc_mag, eps), -1, 1)), dt)"
  }
}